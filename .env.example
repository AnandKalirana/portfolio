# Neon connection string (server-only)
DATABASE_URL=
# Random 32+ char secret used to sign admin session cookies
SESSION_SECRET=
# bcrypt hash of your admin password: node scripts/hash-password.mjs
# In .env.local escape each $ as \$ (the script prints the escaped form)
ADMIN_PASSWORD_HASH=
# Public Web3Forms access key for the contact form
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Neon Object Storage (public_read bucket for portrait, resume, project images).
# Named STORAGE_* because Vercel reserves AWS_* variable names.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-2
STORAGE_BUCKET=portfolio-public
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
